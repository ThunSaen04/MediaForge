<UserControl x:Class="MediaForge.Views.EditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MediaForge.Localization"
             xmlns:ui="clr-namespace:MediaForge.UI"
             xmlns:c="clr-namespace:MediaForge.Controls">
    <UserControl.Resources>
        <!-- Single-file tools share one card width. -->
        <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="720"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="24,8,24,24"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Shared output folder -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18" HorizontalAlignment="Left" Width="720">
            <TextBlock DockPanel.Dock="Left" Text="{l:Tr Lbl_OutputFolder}" VerticalAlignment="Center" Margin="0,0,14,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{l:Tr Hint_EditOutput}" Style="{StaticResource Hint}"/>
            <c:FileBox FilePath="{Binding OutputFolder}" IsFolder="True"/>
        </DockPanel>

        <TabControl Style="{StaticResource SegmentedTabs}">
            <!-- Trim -->
            <TabItem Header="{l:Tr Edit_Trim}" DataContext="{Binding Trim}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Padding="24,8,24,24" MaxWidth="1180" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Lbl_InputFile}" Style="{StaticResource FieldLabel}"/>
                            <c:FileBox FilePath="{Binding Input}"/>
                            <TextBlock Text="{Binding InputInfo}" Style="{StaticResource Hint}"/>

                            <!-- Timeline + transport. Shortcuts live here (no text boxes inside), and the
                                 buttons don't take focus so Space keeps meaning play/pause. -->
                            <StackPanel x:Name="TimelinePanel">
                                <StackPanel.InputBindings>
                                    <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}"/>
                                    <KeyBinding Key="I" Command="{Binding MarkInCommand}"/>
                                    <KeyBinding Key="O" Command="{Binding MarkOutCommand}"/>
                                    <KeyBinding Key="Delete" Command="{Binding CutSelectionCommand}"/>
                                    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
                                </StackPanel.InputBindings>
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Margin" Value="0,0,6,6"/>
                                    </Style>
                                    <Style x:Key="ToolIcon" TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </StackPanel.Resources>

                                <DockPanel Margin="0,18,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding PositionText}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource ToolIcon}" Content="&#xE71F;" ToolTip="{l:Tr Btn_ZoomOut}" Click="OnZoomOut"/>
                                        <Button Style="{StaticResource ToolIcon}" Content="&#xE8A3;" ToolTip="{l:Tr Btn_ZoomIn}" Click="OnZoomIn"/>
                                        <Button Style="{StaticResource ToolIcon}" Content="&#xE9A6;" ToolTip="{l:Tr Btn_ZoomFit}" Click="OnZoomFit"/>
                                    </StackPanel>
                                    <TextBlock Text="{l:Tr Lbl_Timeline}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </DockPanel>
                                <c:TrimTimeline x:Name="Timeline" Height="180" Unloaded="OnTimelineUnloaded"
                                                Preview="{Binding Preview}" Duration="{Binding Duration}"
                                                Ranges="{Binding Ranges}" Playhead="{Binding Playhead, Mode=OneWay}"
                                                SelectionStart="{Binding SelectionStart}" SelectionEnd="{Binding SelectionEnd}"
                                                SeekCommand="{Binding SeekCommand}" StatusText="{Binding WaveStatus}"
                                                AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                CutBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                                TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                TrackBrush="{DynamicResource ControlStrongFillColorDefaultBrush}"/>
                                <TextBlock Text="{Binding WaveStatus}" Style="{StaticResource Hint}"/>
                                <TextBlock Text="{l:Tr Hint_Timeline}" Style="{StaticResource Hint}"/>

                                <!-- Listen -->
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Command="{Binding PlayPauseCommand}" Style="{DynamicResource AccentButtonStyle}" Focusable="False"
                                            ToolTip="{l:Tr Btn_Play}" Width="48" Height="34" Margin="0,0,10,6" Padding="0">
                                        <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                                    </Button>
                                    <Button Content="{l:Tr Btn_PlaySelection}" ui:Icon.Glyph="&#xE8B0;" Command="{Binding PlaySelectionCommand}"/>
                                    <Button Content="{l:Tr Btn_PlayJoin}" ui:Icon.Glyph="&#xE71B;" Command="{Binding PlayJoinCommand}"
                                            ToolTip="{l:Tr Tip_PlayJoin}"/>
                                    <CheckBox Content="{l:Tr Trim_SkipCuts}" IsChecked="{Binding SkipCuts}" Focusable="False"
                                              VerticalAlignment="Center" Margin="8,0,0,6"/>
                                </WrapPanel>

                                <!-- Select and edit -->
                                <TextBlock Text="{Binding SelectionText}" Margin="0,10,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <WrapPanel>
                                    <Button Content="{l:Tr Btn_MarkIn}" Command="{Binding MarkInCommand}"/>
                                    <Button Content="{l:Tr Btn_MarkOut}" Command="{Binding MarkOutCommand}" Margin="0,0,14,6"/>
                                    <Button Content="{l:Tr Btn_CutSelection}" ui:Icon.Glyph="&#xE8C6;" Command="{Binding CutSelectionCommand}"/>
                                    <Button Content="{l:Tr Btn_KeepSelection}" ui:Icon.Glyph="&#xE710;" Command="{Binding KeepSelectionCommand}"/>
                                    <Button Content="{l:Tr Btn_KeepOnlySelection}" ui:Icon.Glyph="&#xE71C;" Command="{Binding KeepOnlySelectionCommand}" Margin="0,0,14,6"/>
                                    <Button Content="{l:Tr Btn_Undo}" ui:Icon.Glyph="&#xE7A7;" Command="{Binding UndoCommand}"/>
                                    <Button Content="{l:Tr Btn_ResetRanges}" ui:Icon.Glyph="&#xE72C;" Command="{Binding ResetRangesCommand}"/>
                                </WrapPanel>
                            </StackPanel>

                            <!-- Kept ranges -->
                            <DockPanel Margin="0,14,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Tr Lbl_Ranges}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,4" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextElement.FontSize="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="#"/>
                                <TextBlock Grid.Column="1" Text="{l:Tr Lbl_Start}"/>
                                <TextBlock Grid.Column="3" Text="{l:Tr Lbl_End}"/>
                                <TextBlock Grid.Column="5" Text="{l:Tr Lbl_Length}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <TextBox Grid.Column="1" Text="{Binding StartText}" FontFamily="{StaticResource MonoFont}"/>
                                            <TextBox Grid.Column="3" Text="{Binding EndText}" FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding LengthText}" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
                                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                                <Button Style="{StaticResource SubtleIconButton}" Content="&#xE768;" ToolTip="{l:Tr Tip_PlayRange}" Command="{Binding PlayCommand}"/>
                                                <Button Style="{StaticResource SubtleIconButton}" Content="&#xE74D;" ToolTip="{l:Tr Tip_RemoveRange}" Command="{Binding RemoveCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{l:Tr Hint_TimeFormat}" Style="{StaticResource Hint}"/>

                            <TextBlock Text="{l:Tr Lbl_Mode}" Style="{StaticResource FieldLabel}"/>
                            <RadioButton Content="{l:Tr Trim_Fast}" IsChecked="{Binding Fast}" GroupName="TrimMode"/>
                            <RadioButton Content="{l:Tr Trim_Precise}" IsChecked="{Binding Precise}" GroupName="TrimMode" Margin="0,4,0,0"/>
                            <Button Content="{l:Tr Btn_Trim}" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" MinWidth="200" Height="40" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Merge -->
            <TabItem Header="{l:Tr Edit_Merge}" DataContext="{Binding Merge}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                                <Button Content="{l:Tr Btn_AddFiles}" ui:Icon.Glyph="&#xE710;" Command="{Binding AddCommand}" Margin="0,0,6,4"/>
                                <Button Content="&#xE74A;" FontFamily="{StaticResource IconFont}" ToolTip="{l:Tr Btn_MoveUp}" Command="{Binding UpCommand}" Margin="0,0,6,4" Padding="11,7"/>
                                <Button Content="&#xE74B;" FontFamily="{StaticResource IconFont}" ToolTip="{l:Tr Btn_MoveDown}" Command="{Binding DownCommand}" Margin="0,0,6,4" Padding="11,7"/>
                                <Button Content="{l:Tr Btn_Remove}" ui:Icon.Glyph="&#xE74D;" Command="{Binding RemoveCommand}" Margin="0,0,6,4"/>
                                <Button Content="{l:Tr Btn_Clear}" ui:Icon.Glyph="&#xE894;" Command="{Binding ClearCommand}" Margin="0,0,6,4"/>
                            </WrapPanel>
                            <ListBox x:Name="MergeList" ItemsSource="{Binding Files}" SelectedIndex="{Binding SelectedIndex}"
                                     Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                                     AllowDrop="True" DragOver="OnMergeDragOver" Drop="OnMergeDrop"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Lbl_Mode}" Style="{StaticResource PageTitle}"/>
                            <RadioButton Content="{l:Tr Merge_Fast}" IsChecked="{Binding Fast}" GroupName="MergeMode"/>
                            <RadioButton Content="{l:Tr Merge_Reencode}" IsChecked="{Binding Reencode}" GroupName="MergeMode" Margin="0,4,0,0"/>
                            <TextBlock Text="{l:Tr Hint_Merge}" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{l:Tr Lbl_OutputFormat}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Label" SelectedItem="{Binding Format}" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{l:Tr Lbl_OutputName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="{l:Tr Btn_Merge}" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Height="40" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Volume -->
            <TabItem Header="{l:Tr Edit_Volume}" DataContext="{Binding Volume}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Lbl_InputFile}" Style="{StaticResource FieldLabel}"/>
                            <c:FileBox FilePath="{Binding Input}"/>
                            <TextBlock Text="{Binding InputInfo}" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{l:Tr Lbl_Mode}" Style="{StaticResource FieldLabel}"/>
                            <RadioButton Content="{l:Tr Volume_Normalize}" IsChecked="{Binding Normalize}" GroupName="VolumeMode"/>
                            <ComboBox ItemsSource="{Binding Targets}" DisplayMemberPath="Label" SelectedItem="{Binding Target}"
                                      IsEnabled="{Binding Normalize}" Margin="28,6,0,0" HorizontalAlignment="Stretch"/>
                            <RadioButton Content="{l:Tr Volume_Adjust}" IsChecked="{Binding Adjust}" GroupName="VolumeMode" Margin="0,14,0,0"/>
                            <DockPanel Margin="28,6,0,0" IsEnabled="{Binding Adjust}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GainText}" Width="70" TextAlignment="Right" VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"/>
                                <Slider Minimum="-20" Maximum="20" Value="{Binding GainDb}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                            </DockPanel>
                            <TextBlock Text="{l:Tr Hint_Volume}" Style="{StaticResource Hint}"/>
                            <Button Content="{l:Tr Btn_Process}" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" MinWidth="200" Height="40" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- Speed -->
            <TabItem Header="{l:Tr Edit_Speed}" DataContext="{Binding Speed}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Lbl_InputFile}" Style="{StaticResource FieldLabel}"/>
                            <c:FileBox FilePath="{Binding Input}"/>
                            <TextBlock Text="{Binding InputInfo}" Style="{StaticResource Hint}"/>
                            <TextBlock Text="{l:Tr Lbl_SpeedFactor}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Factors}" DisplayMemberPath="Label" SelectedItem="{Binding Factor}" Width="220" HorizontalAlignment="Left"/>
                            <TextBlock Text="{l:Tr Hint_Speed}" Style="{StaticResource Hint}"/>
                            <Button Content="{l:Tr Btn_Process}" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" MinWidth="200" Height="40" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- GIF -->
            <TabItem Header="{l:Tr Edit_Gif}" DataContext="{Binding Gif}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Lbl_InputVideo}" Style="{StaticResource FieldLabel}"/>
                            <c:FileBox FilePath="{Binding Input}"/>
                            <TextBlock Text="{Binding InputInfo}" Style="{StaticResource Hint}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{l:Tr Lbl_Start}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{l:Tr Lbl_DurationSec}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{l:Tr Lbl_Fps}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label" SelectedItem="{Binding Fps}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="{l:Tr Lbl_Width}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Widths}" DisplayMemberPath="Label" SelectedItem="{Binding Width}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{l:Tr Hint_TimeFormat}" Style="{StaticResource Hint}"/>
                            <Button Content="{l:Tr Btn_MakeGif}" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Left" MinWidth="200" Height="40" Margin="0,24,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
