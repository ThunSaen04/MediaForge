<UserControl x:Class="MediaForge.Views.YouTubeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MediaForge.Localization"
             xmlns:ui="clr-namespace:MediaForge.UI"
             xmlns:c="clr-namespace:MediaForge.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- URL input -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{l:Tr Yt_UrlLabel}" Style="{StaticResource PageTitle}"/>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Margin="10,0,0,0" Width="150">
                        <Button Content="{l:Tr Yt_Analyze}" ui:Icon.Glyph="&#xE721;" Command="{Binding AnalyzeCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <Button Content="{l:Tr Yt_Paste}" ui:Icon.Glyph="&#xE77F;" Command="{Binding PasteCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <TextBox Text="{Binding Urls, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap"
                             Height="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </DockPanel>
                <TextBlock Text="{l:Tr Hint_YtUrls}" Style="{StaticResource Hint}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Entries -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="20,14,16,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:Tr Btn_SelectAll}" ui:Icon.Glyph="&#xE8B3;" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                            <Button Content="{l:Tr Btn_SelectNone}" ui:Icon.Glyph="&#xE8E6;" Command="{Binding SelectNoneCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ListSummary}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="20,8,16,14"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="{l:Tr Btn_Cancel}" Command="{Binding CancelAnalyzeCommand}" Margin="12,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="4"/>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid Margin="8,0,8,8">
                        <ListView ItemsSource="{Binding Entries}" Style="{StaticResource FlatList}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="44">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" MinWidth="0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding IndexText}"/>
                                    <GridViewColumn Header="{l:Tr Col_Title}" Width="400" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="{l:Tr Col_Duration}" Width="80" DisplayMemberBinding="{Binding DurationText}"/>
                                    <GridViewColumn Header="{l:Tr Col_Playlist}" Width="200" DisplayMemberBinding="{Binding PlaylistTitle}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Grid Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}" IsHitTestVisible="False">
                            <Rectangle Style="{StaticResource DropZone}" Margin="8,40,8,4"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="{l:Tr Hint_YtEmpty}" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Options (download button pinned below so it is always visible) -->
            <DockPanel Grid.Column="2">
                <Button DockPanel.Dock="Bottom" Content="{Binding DownloadText}" Command="{Binding DownloadCommand}"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.AutomationId="DownloadButton"
                        HorizontalAlignment="Stretch" Height="44" Margin="0,12,0,0" FontWeight="SemiBold"/>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,16,20,20">
                            <TextBlock Text="{l:Tr Yt_DownloadAs}" Style="{StaticResource PageTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="{l:Tr Yt_Video}" IsChecked="{Binding IsVideo}" GroupName="YtMode" Margin="0,0,20,0"/>
                                <RadioButton Content="{l:Tr Yt_AudioOnly}" IsChecked="{Binding IsAudio}" GroupName="YtMode"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr Lbl_Quality}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding VideoQualities}" DisplayMemberPath="Label" SelectedItem="{Binding VideoQuality}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:Tr Lbl_Container}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding Containers}" DisplayMemberPath="Label" SelectedItem="{Binding Container}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Content="{l:Tr Yt_EmbedSubs}" IsChecked="{Binding EmbedSubtitles}" Margin="0,14,0,0"/>
                                <DockPanel Margin="28,4,0,0" IsEnabled="{Binding EmbedSubtitles}">
                                    <TextBlock Text="{l:Tr Lbl_Languages}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding SubtitleLanguages}"/>
                                </DockPanel>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsAudio, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:Tr Lbl_Format}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding AudioFormats}" DisplayMemberPath="Label" SelectedItem="{Binding AudioFormat}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:Tr Lbl_Quality}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding AudioQualities}" DisplayMemberPath="Label" SelectedItem="{Binding AudioQuality}" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding IsAudioQualityEnabled}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="{l:Tr Yt_Options}" Style="{StaticResource SectionHeader}"/>
                            <CheckBox Content="{l:Tr Yt_EmbedThumbnail}" IsChecked="{Binding EmbedThumbnail}"/>
                            <CheckBox Content="{l:Tr Yt_EmbedMetadata}" IsChecked="{Binding EmbedMetadata}"/>
                            <CheckBox Content="{l:Tr Yt_NumberPrefix}" IsChecked="{Binding NumberPrefix}"/>
                            <CheckBox Content="{l:Tr Yt_PlaylistFolder}" IsChecked="{Binding PlaylistFolder}"/>

                            <TextBlock Text="{l:Tr Lbl_SaveTo}" Style="{StaticResource SectionHeader}"/>
                            <c:FileBox FilePath="{Binding OutputFolder}" IsFolder="True"/>
                            <Button Content="{l:Tr Btn_OpenFolder}" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenOutputCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
