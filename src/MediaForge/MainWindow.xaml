<Window x:Class="MediaForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MediaForge.Localization"
        xmlns:core="clr-namespace:MediaForge.Core"
        xmlns:ui="clr-namespace:MediaForge.UI"
        xmlns:v="clr-namespace:MediaForge.Views"
        Title="MediaForge" Width="1280" Height="880" MinWidth="1020" MinHeight="680"
        Icon="Assets/MediaForge.ico" WindowStartupLocation="CenterScreen">
    <!-- Content extends into the title bar; DWM still draws the caption buttons over the Mica backdrop. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="True" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Image Source="Assets/logo.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="MediaForge" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <!-- Sidebar -->
        <DockPanel Grid.Row="1" Margin="8,4,8,12">
            <TextBlock DockPanel.Dock="Bottom" Margin="16,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{l:Tr About_DevelopedBy}"/>
                <Hyperlink NavigateUri="{x:Static core:AppInfo.WebsiteUri}"
                           ToolTip="{x:Static core:AppInfo.Website}"><Run Text="{x:Static core:AppInfo.Developer}"/></Hyperlink>
            </TextBlock>
            <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavItem}"
                         Content="{l:Tr Tab_Settings}" ui:Icon.Glyph="&#xE713;"/>
            <StackPanel>
                <RadioButton x:Name="NavConvert" Style="{StaticResource NavItem}" IsChecked="True"
                             Content="{l:Tr Tab_Convert}" ui:Icon.Glyph="&#xE8AB;"/>
                <RadioButton x:Name="NavEdit" Style="{StaticResource NavItem}"
                             Content="{l:Tr Tab_Edit}" ui:Icon.Glyph="&#xE8C6;"/>
                <RadioButton x:Name="NavYouTube" Style="{StaticResource NavItem}"
                             Content="{l:Tr Tab_YouTube}" ui:Icon.Glyph="&#xE896;"/>
                <RadioButton x:Name="NavMetadata" Style="{StaticResource NavItem}"
                             Content="{l:Tr Tab_Metadata}" ui:Icon.Glyph="&#xE8EC;"/>
            </StackPanel>
        </DockPanel>

        <!-- Content layer -->
        <Border Grid.Row="1" Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="340"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="220" MinHeight="120"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="32,24,32,0">
                <!-- Update banner (InfoBar style) -->
                <Border DockPanel.Dock="Top" DataContext="{Binding Update}" Margin="0,0,0,18" Padding="16,12"
                        CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="18" Margin="0,2,14,0"
                                   VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <!-- Actions -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVis}}">
                            <Button Content="{l:Tr Upd_InstallNow}" Command="{Binding InstallCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="UpdateNowButton" Margin="0,0,6,0"/>
                            <Button Content="{l:Tr Upd_Details}" Command="{Binding ViewReleaseCommand}" Margin="0,0,6,0"/>
                            <Button Content="&#xE711;" Style="{StaticResource SubtleIconButton}" ToolTip="{l:Tr Upd_Later}"
                                    Command="{Binding DismissCommand}"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Tr Btn_Cancel}" Command="{Binding CancelDownloadCommand}"
                                VerticalAlignment="Center" Margin="16,0,0,0"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding BannerTitle, Mode=OneWay}"/>
                                <Run Text="{Binding BannerDetail, Mode=OneWay}" FontWeight="Normal" FontSize="12"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Hint}" Margin="0,4,0,0" MaxHeight="36"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsDownloading, Converter={StaticResource InverseBoolToVis}}"/>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Height="4" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="{l:Tr Upd_Downloading}"/>
                                    <Run Text="·"/>
                                    <Run Text="{Binding ProgressText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Pages stay alive while hidden so lists and inputs keep their state. -->
                <Grid>
                    <DockPanel Visibility="{Binding IsChecked, ElementName=NavConvert, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <TextBlock Text="{l:Tr Tab_Convert}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{l:Tr Page_Convert}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <v:ConvertView DataContext="{Binding Convert}"/>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsChecked, ElementName=NavEdit, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <TextBlock Text="{l:Tr Tab_Edit}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{l:Tr Page_Edit}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <v:EditView DataContext="{Binding Edit}"/>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsChecked, ElementName=NavYouTube, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <TextBlock Text="{l:Tr Tab_YouTube}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{l:Tr Page_YouTube}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <v:YouTubeView DataContext="{Binding YouTube}"/>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsChecked, ElementName=NavMetadata, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <TextBlock Text="{l:Tr Tab_Metadata}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{l:Tr Page_Metadata}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <v:MetadataView DataContext="{Binding Metadata}"/>
                    </DockPanel>
                    <DockPanel Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <TextBlock Text="{l:Tr Tab_Settings}" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="{l:Tr Page_Settings}" Style="{StaticResource PageSubtitle}"/>
                        </StackPanel>
                        <v:SettingsView DataContext="{Binding Settings}"/>
                    </DockPanel>
                </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                <v:QueueView Grid.Row="2" DataContext="{Binding Queue}" Margin="32,0,32,20"/>
            </Grid>
        </Border>
    </Grid>
</Window>
